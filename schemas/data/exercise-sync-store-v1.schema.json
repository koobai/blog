{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jingzhe.example/schemas/data/exercise-sync-store-v1.schema.json",
  "title": "Jingzhe source-neutral activity fact store v1",
  "description": "Repository storage used between an Activity Sync Gateway and the blog processor. Producer diagnostics are intentionally not persisted.",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,63}$": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "exercise-sync-v1.schema.json#/$defs/activity"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-jingzhe-contract": {
    "identity": ["source", "external_id"],
    "producer_persisted": false,
    "processor_fields_persisted": false
  }
}
