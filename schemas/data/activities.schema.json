{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jingzhe processed activities",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["run_id", "name", "type", "distance", "moving_time", "start_date_local", "route_status", "display_name", "sport_display_name", "card_achievement", "calendar_achievements"],
    "properties": {
      "run_id": {"type": ["integer", "string"]},
      "name": {"type": "string"},
      "type": {"type": "string", "minLength": 1},
      "distance": {"type": "number", "minimum": 0},
      "moving_time": {"type": "string"},
      "pace_num": {"type": "string"},
      "pace_unit": {"type": "string"},
      "average_heartrate": {"type": "number", "minimum": 0},
      "total_elevation_gain": {"type": "number"},
      "calories": {"type": "number", "minimum": 0},
      "start_date_local": {"type": "string", "minLength": 1},
      "start_date_utc": {"type": "string"},
      "route_status": {"enum": ["available", "privacy_hidden", "unavailable", "pending", "indoor"]},
      "is_indoor": {"type": "boolean"},
      "summary_polyline": {"type": "string"},
      "energy_title": {"type": "string"},
      "food_key": {"type": "string"},
      "distance_title": {"type": "string"},
      "distance_title_key": {"type": "string"},
      "display_name": {"type": "string"},
      "sport_display_name": {"type": "string"},
      "card_achievement": {
        "type": ["object", "null"],
        "properties": {
          "group": {"enum": ["ride", "run_walk"]},
          "level": {"enum": ["year", "month"]},
          "label": {"type": "string"}
        },
        "required": ["group", "level", "label"],
        "additionalProperties": false
      },
      "calendar_achievements": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "group": {"enum": ["ride", "run_walk"]},
            "group_label": {"type": "string"},
            "level": {"enum": ["year", "month"]},
            "label": {"type": "string"}
          },
          "required": ["group", "group_label", "level", "label"],
          "additionalProperties": false
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {"route_status": {"not": {"const": "available"}}},
          "required": ["route_status"]
        },
        "then": {
          "properties": {"summary_polyline": {"maxLength": 0}}
        }
      }
    ],
    "additionalProperties": true
  }
}
